class DemoRenderer:
    """世界(左)と情報パネル(右)を描き、PNGフレームとして保存する。"""

    def __init__(self, world, robot):
        self.world = world
        self.robot = robot
        self.trail = [(robot.x, robot.y)]
        self.sim_time = 0.0
        self.idx = 0
        self.fig = plt.figure(figsize=(12.8, 7.2), dpi=100)
        self.ax = self.fig.add_axes([0.015, 0.02, 0.54, 0.92])
        self._texts = []

    def _panel(self, lines):
        for t in self._texts:
            try:
                t.remove()
            except Exception:
                pass
        self._texts = []
        y = 0.95
        for (text, size, weight, color) in lines:
            t = self.fig.text(0.575, y, text, fontsize=size, fontweight=weight,
                              color=color, va="top")
            self._texts.append(t)
            y -= size * 0.0022

    def draw(self, title, panel_lines):
        ax = self.ax
        ax.clear()
        ax.set_xlim(-0.35, 10.35)
        ax.set_ylim(-0.35, 10.35)
        ax.set_aspect("equal")
        for i in range(11):
            ax.axhline(i, color="#ececec", lw=0.6, zorder=0)
            ax.axvline(i, color="#ececec", lw=0.6, zorder=0)
        for (x0, y0, x1, y1) in self.world.obstacles:
            ax.add_patch(Rectangle((x0, y0), x1 - x0, y1 - y0,
                                   facecolor="#8d6e63", edgecolor="#6d4c41", zorder=2))
        gx, gy = self.world.goal
        ax.add_patch(Circle((gx, gy), 0.45, fill=False, ls="--",
                            color="#f9a825", lw=1.6, zorder=3))
        ax.plot([gx], [gy], marker="*", ms=24, color="#f9a825", mec="#f57f17", zorder=3)
        sx, sy = self.world.start
        ax.plot([sx], [sy], marker="o", ms=8, color="#90a4ae", zorder=3)
        if len(self.trail) > 1:
            xs = [p[0] for p in self.trail]
            ys = [p[1] for p in self.trail]
            ax.plot(xs, ys, color="#42a5f5", lw=2.0, alpha=0.85, zorder=3)
        r = self.robot
        ax.add_patch(Circle((r.x, r.y), self.world.robot_radius,
                            facecolor="#1e88e5", edgecolor="#0d47a1", zorder=5))
        ax.annotate("", xy=(r.x + 0.62 * math.cos(r.th), r.y + 0.62 * math.sin(r.th)),
                    xytext=(r.x, r.y), zorder=6,
                    arrowprops=dict(arrowstyle="-|>", color="#d81b60", lw=2.2,
                                    mutation_scale=22))
        ax.set_title(title, fontsize=15, fontweight="bold", loc="left", pad=8)
        self._panel(panel_lines)
        self.fig.canvas.draw()
        buf = self.fig.canvas.buffer_rgba()
        img = Image.frombuffer("RGBA", self.fig.canvas.get_width_height(), buf).convert("RGB")
        img.save(os.path.join(OUT_DIR, f"f{self.idx:05d}.png"))
        self.idx += 1


def cmd_lines(cmd_text, js, status, color="#1565c0", extra=None):
    lines = [
        ("【あなたの指示(日本語)】", 13, "bold", "#37474f"),
        (cmd_text, 17, "normal", "#212121"),
        ("", 8, "normal", "#212121"),
        ("【AIが生成した動作命令(JSON)】", 13, "bold", "#37474f"),
        (js, 15, "normal", "#1b5e20"),
        ("", 8, "normal", "#212121"),
        ("【安全確認】許可リスト内のaction・duration上限5.0秒を満たす", 11, "normal", "#455a64"),
        ("", 8, "normal", "#212121"),
        (status, 15, "bold", color),
    ]
    if extra:
        lines += extra
    return lines


def manual_segment(rd, robot, title, cmd_text, total_frames):
    """日本語指示 → AI解析(JSON) → 安全検証 → 実行、の一連を描画する。"""
    parsed = parse_command(cmd_text)
    js = to_json(parsed)
    san, ok, reason = sanitize(js)
    entry = {"input": cmd_text, "ai_json": js, "safety": reason, "executed": ok}

    for _ in range(20):
        rd.draw(title, cmd_lines(cmd_text, js,
                "【状態】 実行準備完了(安全チェック通過)", "#e65100"))

    v, w = MANUAL_VECS[san["action"]]
    steps = int(round(san["duration"] / DT))
    collided = False
    x0, y0, th0 = robot.x, robot.y, robot.th
    for i in range(steps):
        moved = robot.apply(v, w)
        rd.sim_time += DT
        if moved:
            rd.trail.append((robot.x, robot.y))
        else:
            collided = True
        st = f"【状態】 実行中… {(i + 1) * DT:.1f}/{san['duration']:.1f}秒"
        rd.draw(title, cmd_lines(cmd_text, js, st, "#1565c0"))
        if collided:
            break

    moved_m = math.hypot(robot.x - x0, robot.y - y0)
    turn_deg = math.degrees(robot.th - th0)
    res = "衝突検出→緊急停止" if collided else "衝突なし"
    st = (f"【状態】 完了: {san['action']} {san['duration']:.1f}秒 / "
          f"実移動 {moved_m:.2f}m / 回転 {turn_deg:.0f}度 / {res}")
    rest = max(0, total_frames - 20 - steps)
    for _ in range(rest):
        rd.draw(title, cmd_lines(cmd_text, js, st,
                "#b71c1c" if collided else "#2e7d32"))
    entry.update({"action": san["action"], "duration": san["duration"], "steps": steps,
                  "moved_m": round(moved_m, 3), "turn_deg": round(turn_deg, 1),
                  "collided": collided})
    return entry


def auto_segment(rd, robot, title, cmd_text, total_frames, max_steps=900):
    """A*経路計画AIによる自律ナビゲーションを描画する(表示3倍速)。"""
    parsed = parse_command(cmd_text)
    js = to_json(parsed)
    san, ok, reason = sanitize(js)
    entry = {"input": cmd_text, "ai_json": js, "safety": reason, "executed": ok}

    path = astar(robot.world, (robot.x, robot.y), robot.world.goal)
    assert path is not None

    for _ in range(20):
        rd.draw(title, cmd_lines(cmd_text, js,
                "【状態】 A*経路計画AIが経路を生成・自律行動を準備", "#e65100"))

    motion_frames = 0
    steps = 0
    outcome = "timeout"
    for step in range(1, max_steps + 1):
        v, w, done = compute_cmd(robot, path)
        if done:
            outcome = "goal"
            break
        moved = robot.apply(v, w)
        rd.sim_time += DT
        steps = step
        if moved:
            rd.trail.append((robot.x, robot.y))
        else:
            outcome = "collision"
            break
        if step % 3 == 0:  # 3ステップに1フレーム = 表示3倍速
            st = (f"【状態】 AI(A*経路計画)が自律行動中… {steps}ステップ / "
                  f"ゴールまで {robot.dist_to_goal():.2f}m(表示3倍速)")
            rd.draw(title, cmd_lines(cmd_text, js, st, "#1565c0",
                    extra=[(f"AIが選択した速度指令: v={v:.2f}m/s w={w:.2f}rad/s", 12, "normal", "#4a148c")]))
            motion_frames += 1

    if outcome == "goal":
        st = f"【状態】 ゴール到達! {steps}ステップ({steps * DT:.1f}秒)で自律走行成功(衝突なし)"
        color = "#2e7d32"
    elif outcome == "collision":
        st = "【状態】 衝突を検出 → 安全のため即停止(自律走行は失敗)"
        color = "#b71c1c"
    else:
        st = "【状態】 規定ステップ内にゴール未到達(失敗として記録)"
        color = "#b71c1c"
    rest = max(0, total_frames - 20 - motion_frames)
    for _ in range(rest):
        rd.draw(title, cmd_lines(cmd_text, js, st, color))
    entry.update({"outcome": outcome, "steps": steps})
    return entry


